# ============================================================
# Aegis-Bot settings
#
# Copy to .env and fill in. Lines marked (required) must be set;
# the rest have the default shown and can stay commented out.
# scripts/tidy_env.py sorts an existing .env into this layout.
# ============================================================

# ------------------------------------------------------------
# Discord
# ------------------------------------------------------------

# Bot token from the Discord developer portal. (required)
DISCORD_TOKEN=
# ID of the Discord server the commands are registered in. (required)
GUILD_ID=
# Channel for alerts and summaries. (required)
ALERT_CHANNEL_ID=
# Mentioned for torrents that were not added through the bot.
DISCORD_USER_ID=

# ------------------------------------------------------------
# Fluxer (alerts only)
# ------------------------------------------------------------

# Fluxer webhook URL; every alert is also posted there. Empty: off.
FLUXER_WEBHOOK_URL=

# ------------------------------------------------------------
# Monitoring
# ------------------------------------------------------------

# Seconds between checks, per-check time limit, and how long a monitor
# may go without a successful check before its state counts as stale.
MONITOR_INTERVAL=60
MONITOR_TIMEOUT=30
MONITOR_STALE_DURATION=300
# Minimum seconds between two non-critical alerts for the same thing.
ALERT_COOLDOWN=1800

# Filesystem usage, percent.
FILESYSTEM_WARNING=85
FILESYSTEM_CRITICAL=95

# iDRAC temperatures, degrees Celsius.
TEMPERATURE_WARNING=70
TEMPERATURE_CRITICAL=85

# CPU usage, percent, and how many seconds it must last.
CPU_WARNING=75
CPU_WARNING_DURATION=300
CPU_CRITICAL=90
CPU_CRITICAL_DURATION=300
CPU_RECOVERY_THRESHOLD=65
CPU_CRITICAL_RECOVERY_THRESHOLD=80
CPU_RECOVERY_DURATION=120

# Memory usage, percent, and how many seconds it must last.
MEMORY_WARNING=80
MEMORY_WARNING_DURATION=300
MEMORY_CRITICAL=90
MEMORY_CRITICAL_DURATION=300
MEMORY_RECOVERY_THRESHOLD=75
MEMORY_CRITICAL_RECOVERY_THRESHOLD=85
MEMORY_RECOVERY_DURATION=120

# Warn when an SSD has this percentage of its rated life left, or less.
SSD_LIFE_WARNING=10

# ------------------------------------------------------------
# iDRAC
# ------------------------------------------------------------

# Address and login of the Dell iDRAC. (required)
IDRAC_HOST=
IDRAC_USERNAME=
IDRAC_PASSWORD=

# Alert on new entries in iDRAC's System Event Log (Warning, Critical).
IDRAC_EVENT_LOG=true
# true: also post informational (OK) entries.
IDRAC_EVENT_LOG_ALL=false

# ------------------------------------------------------------
# Internet
# ------------------------------------------------------------

# Seconds without internet before "WAN Connection Lost" is posted.
WAN_OUTAGE_DURATION=120
# Containers to restart through Portainer after an outage, comma
# separated, e.g. newt for Pangolin. Empty: nothing is restarted.
WAN_RECOVERY_RESTART=
# Only after an outage of at least this many seconds, and this many
# seconds after the connection is back.
WAN_RECOVERY_MIN_OUTAGE=60
WAN_RECOVERY_DELAY=30

# ------------------------------------------------------------
# ESXi (optional)
# ------------------------------------------------------------

# Host and a user with the read-only role. Empty: ESXi is not checked.
ESXI_HOST=
ESXI_USERNAME=
ESXI_PASSWORD=
# Datastore usage, percent.
ESXI_DATASTORE_WARNING=85
ESXI_DATASTORE_CRITICAL=95
# Warn once a day about snapshots older than this many days; 0 = off.
ESXI_SNAPSHOT_DAYS=7
# Virtual machines not to watch, comma separated.
ESXI_IGNORE_VMS=

# ------------------------------------------------------------
# Public services (optional)
# ------------------------------------------------------------

# Full URLs to check, comma separated, e.g. the services published
# through Pangolin (https://...). Empty: nothing is checked.
UPTIME_URLS=
# Seconds between checks, and how long one request may take.
UPTIME_INTERVAL=300
UPTIME_TIMEOUT=15
# Warn when a certificate expires in fewer days than this (critical
# below 3 days).
UPTIME_CERT_DAYS=14

# ------------------------------------------------------------
# Minecraft (optional)
# ------------------------------------------------------------

# Java Edition servers as name=host:port, comma separated; the port
# defaults to 25565. Empty: /minecraft and its monitor are off.
MINECRAFT_SERVERS=
# true: post "X joined <server>" and "X left <server>" as info.
MINECRAFT_JOIN_ALERTS=false
# Server names that alert when they stop answering, comma separated.
# Empty: no down alerts.
MINECRAFT_WATCH=

# ------------------------------------------------------------
# Wake-on-LAN through GPTWOL
# ------------------------------------------------------------

# Address of the GPTWOL container. (required)
GPTWOL_HOST=
GPTWOL_PORT=5000
GPTWOL_TIMEOUT=10
# The computer: name shown in /wol, its IP and MAC (IP and MAC
# required), and how GPTWOL checks whether it is awake (arp or icmp).
GPTWOL_TARGET_NAME=Computer
GPTWOL_TARGET_IP=
GPTWOL_TARGET_MAC=
GPTWOL_TARGET_TEST_TYPE=arp

# ------------------------------------------------------------
# qBittorrent
# ------------------------------------------------------------

# Address and login of the Web UI. (required)
QBITTORRENT_HOST=
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
QBITTORRENT_TIMEOUT=10

# true: torrents from non-administrators wait for an administrator's approval.
REQUEST_APPROVAL=false
# What /torrent cleanup counts as seeded enough.
SEED_RATIO_TARGET=2
SEED_DAYS_TARGET=14
# Alert when qBittorrent uses the home address instead of its VPN, or
# reports no connection for three checks. false turns it off.
VPN_CHECK=true

# ------------------------------------------------------------
# Jackett
# ------------------------------------------------------------

JACKETT_URL=
JACKETT_API_KEY=
# Indexer IDs, comma separated. Empty: rutracker (RuTracker.org, needs
# an account in Jackett), thepiratebay, 1337x.
JACKETT_INDEXERS=
# Seconds to wait for a search.
JACKETT_TIMEOUT=120

# ------------------------------------------------------------
# Jellyfin
# ------------------------------------------------------------

# Servers, numbered from 1. Server 1 is your own library. USER is the
# Jellyfin user whose watched state /jellyfin movies shows.
JELLYFIN_1_URL=
JELLYFIN_1_API_KEY=
JELLYFIN_1_NAME=
JELLYFIN_1_USER=
JELLYFIN_2_URL=
JELLYFIN_2_API_KEY=
JELLYFIN_2_NAME=
JELLYFIN_2_USER=

# Library folders as seen inside the container. Setting these enables
# downloading from another Jellyfin server.
JELLYFIN_MOVIES_DIR=
JELLYFIN_SERIES_DIR=

# Refresh Jellyfin and say "Now in Jellyfin" after a torrent completes.
JELLYFIN_REFRESH_ON_COMPLETE=true
# Daily report of new seasons and episodes on the other servers.
JELLYFIN_NEW_CONTENT_ALERTS=true
JELLYFIN_NEW_CONTENT_HOUR=10

# ------------------------------------------------------------
# Subtitles
# ------------------------------------------------------------

# Preferred language: a name or code such as english, en, nl.
SUBTITLE_LANGUAGE=eng
# Fetch missing movie subtitles through Jellyfin's Open Subtitles plugin.
SUBTITLE_AUTO_DOWNLOAD=true
# Movies tried in the daily run (0 turns it off), and its hour.
SUBTITLE_DAILY_LIMIT=10
SUBTITLE_HOUR=6
# Prefer subtitles for the hearing impaired.
SUBTITLE_HEARING_IMPAIRED=false
# Also series episodes: a single downloaded episode right away, the rest
# (and season packs) in the daily run, sharing SUBTITLE_DAILY_LIMIT.
SUBTITLE_SERIES=true

# ------------------------------------------------------------
# Portainer (/container)
# ------------------------------------------------------------

# Address as seen from inside the bot's container, an access token
# (My account > Access tokens) and the environment number.
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=
# Discord user IDs allowed to use /container, comma separated. Empty: nobody.
PORTAINER_ALLOWED_USER_IDS=
# Containers that cannot be stopped, restarted, killed or removed from Discord.
PORTAINER_PROTECTED=
# false only for HTTPS with a self-signed certificate.
PORTAINER_VERIFY_TLS=true
# Alert when a container crashes, turns unhealthy or keeps restarting.
CONTAINER_ALERTS=true
# Containers to leave out of those alerts, comma separated.
CONTAINER_ALERTS_IGNORE=

# ------------------------------------------------------------
# Weekly summary
# ------------------------------------------------------------

WEEKLY_SUMMARY=true
WEEKLY_SUMMARY_DAY=sunday
WEEKLY_SUMMARY_HOUR=10
# List what was added to each Jellyfin server this week ("New in Jellyfin").
WEEKLY_SUMMARY_NEW_CONTENT=true
# "Watched this week" from the primary Jellyfin server; needs its
# Playback Reporting plugin.
WEEKLY_SUMMARY_WATCH_STATS=true
# Watchtower's container; its log (read through Portainer) gives the
# "Container updates" field.
WATCHTOWER_CONTAINER=watchtower

# ------------------------------------------------------------
# Scripts on the server (watchdog.sh, backup.sh)
# ------------------------------------------------------------

# Discord webhook for the watchdog and the backup result.
WATCHDOG_WEBHOOK_URL=

# Folders packed into the weekly archive, separated by spaces.
BACKUP_PATHS=
# Extra patterns or full paths to skip, separated by spaces.
BACKUP_EXCLUDE=
# Folders mirrored instead of packed: full upload once, then only changes.
BACKUP_SYNC_PATHS=
# Local copy of those folders. Empty: <BACKUP_LOCAL_DIR>/mirror.
BACKUP_MIRROR_DIR=
# Containers stopped while packing, app before its database.
BACKUP_STOP_CONTAINERS=
# Local archives: where, and how many to keep.
BACKUP_LOCAL_DIR=/var/backups/aegis-bot
BACKUP_KEEP_LOCAL=4
# Size of each archive part.
BACKUP_PART_SIZE=256M
# rclone destination, e.g. proton:Backups/home. Empty: local only.
BACKUP_REMOTE=
BACKUP_KEEP_REMOTE=8
# The bot alerts when the last successful backup is older than this
# many days (0 turns it off).
BACKUP_MAX_AGE_DAYS=8
