# Runs the root-owned copy of update_host.sh as the server's own user.
# Installed by scripts/install_update_service.sh.
[Unit]
Description=Update and restart Aegis-Bot
After=docker.service network-online.target

[Service]
Type=oneshot
User=__USER__
ExecStart=/bin/bash __SCRIPT__
TimeoutStartSec=900
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
